{
  "version": 2,
  "buildCommand": "node build.js",
  "outputDirectory": "smart-event-management-system/frontend/dist",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{smart-event-management-system/backend/**,smart-event-management-system/frontend/dist/**}",
      "excludeFiles": "{**/node_modules/**,**/venv/**,**/.venv/**,**/__pycache__/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__route=/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py?__route=/api/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
